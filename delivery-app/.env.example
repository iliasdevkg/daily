# delivery-app build/runtime environment.
#
# Currently unused: api.js calls a relative '/api' path, which works both
# in local dev (Vite's own proxy — see vite.config.js) and in production
# (this container's own nginx.conf proxies /api/* to the backend service —
# see the comment at the top of nginx.conf). No env var is required for
# the app to reach the API correctly in either environment.
#
# VITE_API_URL is here as an escape hatch only — if you ever deploy this
# app somewhere that CAN'T proxy /api itself (e.g. a static host like
# Vercel/Netlify with no server-side proxy config), set this to the full
# backend URL and update api.js's `const BASE = '/api'` to
# `const BASE = import.meta.env.VITE_API_URL || '/api'`. Not done by
# default since the nginx-proxy approach needs no code change at all.
VITE_API_URL=
