# backend/.env.example
# Copy to backend/.env for local dev, or paste these as Environment Variables
# in the Render dashboard for production. Never commit the real .env file.

# --- Server -----------------------------------------------------------------
# Render injects its own PORT automatically in production; this default is
# only used for local dev.
PORT=3001
NODE_ENV=development

# --- Database -----------------------------------------------------------------
# Production (Supabase): set DATABASE_URL to the "Connection Pooling" string
# from Supabase → Project Settings → Database (uses port 6543, pgbouncer).
# Example: postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# When DATABASE_URL is set, the discrete DB_* vars below are ignored.
DATABASE_URL=

# Local dev only (used when DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=delivery_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth ---------------------------------------------------------------------
# Generate a real value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Example shape only — generate your own, do not reuse this one:
# 75b1fe3ef932f0b6aade073304c830c0e31c6b29e7eb207cb2b864e8fb9a45a21c9bcaba4f14cd1bc7f7e4ffee674639
JWT_SECRET=

# --- Google Sign-In ------------------------------------------------------------
# The "Web application" OAuth client ID from Google Cloud Console
# (APIs & Services -> Credentials). Used to verify ID tokens from the app.
GOOGLE_WEB_CLIENT_ID=

# --- CORS -----------------------------------------------------------------------
# Comma-separated list of exact origins allowed to call this API from a browser.
# Leave empty for local dev (same-origin/non-browser requests are always allowed).
# Example for production:
# ALLOWED_ORIGINS=https://daily-frontend.vercel.app,https://daily-admin.vercel.app,https://daily-delivery.vercel.app,https://daily-picker.vercel.app
ALLOWED_ORIGINS=

# --- Redis (optional) -----------------------------------------------------------
# Unset: bus.js/queue.js run in single-instance/local mode (identical to
# behavior before this variable existed). Set: enables Redis pub/sub (bus.js
# — required for >1 backend instance) and BullMQ queues (queue.js — retry/
# backoff/dead-letter for notifications, history, earnings, email).
# Example: redis://localhost:6379 or redis://default:PASSWORD@host:6379
REDIS_URL=

# --- Email (optional) -------------------------------------------------------------
# Unset: email.js logs what it would send instead of sending (safe no-op —
# nothing in the product triggers an email today, this is infrastructure
# for a future feature like password reset). Set all of these to activate.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@daily.kg

# --- Observability (optional) -----------------------------------------------------
# Sentry project DSN — unset disables error tracking entirely (sentry.js
# no-ops). Get one at sentry.io -> your project -> Settings -> Client Keys.
SENTRY_DSN=

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
