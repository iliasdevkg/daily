# Repo-root .env — docker-compose reads THIS file automatically for
# ${VARIABLE} substitution inside docker-compose.prod.yml (a separate
# mechanism from `env_file:`, which only injects vars into a container,
# not into the compose YAML itself). Copy to .env and fill in real values
# before `docker compose -f docker-compose.prod.yml up`.
#
# backend/.env.production (see backend/.env.example) is what the backend
# container actually reads at runtime — these two files legitimately
# duplicate DB_PASSWORD/etc.; that's intentional; one is for docker-compose
# itself, the other is for the app.

DB_NAME=delivery_db
DB_USER=postgres
DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
LETSENCRYPT_EMAIL=
